rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Authentication & Role Checks
    function isAuth() {
      return request.auth != null;
    }

    function userRole() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    function isSuperAdmin() {
      return isAuth() && (
        request.auth.token.email == 'johnrufai242@gmail.com' ||
        request.auth.token.admin == true ||
        request.auth.token.superAdmin == true
      );
    }

    function isAnyAdmin() {
      return isAuth() && (
        isSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in [
            'SUPER_ADMIN', 'super_admin', 'ADMIN', 'admin',
            'CONTENT_ADMIN', 'EDUCATION_ADMIN', 'SERVICES_ADMIN',
            'MARKETING_ADMIN', 'SUPPORT_ADMIN'
          ]
        )
      );
    }

    function isStaffOrTutor() {
      return isAuth() && (
        isAnyAdmin() ||
        userRole() in ['STAFF', 'staff', 'TUTOR', 'tutor', 'INSTRUCTOR', 'instructor']
      );
    }

    function isSchoolOwner(schoolId) {
      return isAuth() && (
        schoolId == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/schools/$(schoolId)) &&
          (
            get(/databases/$(database)/documents/schools/$(schoolId)).data.adminUid == request.auth.uid ||
            get(/databases/$(database)/documents/schools/$(schoolId)).data.userId == request.auth.uid
          )
        )
      );
    }

    // ==========================================
    // USERS & PORTAL PROFILES
    // ==========================================
    match /users/{userId} {
      allow read: if isAnyAdmin() || (isAuth() && request.auth.uid == userId);
      allow create: if isAuth() && (request.auth.uid == userId || isAnyAdmin());
      allow update: if isAuth() && (isSuperAdmin() || isAnyAdmin() || request.auth.uid == userId);
      allow delete: if isSuperAdmin();
    }

    match /admins/{userId} {
      allow read: if isSuperAdmin() || (isAuth() && request.auth.uid == userId);
      allow write: if isSuperAdmin();
    }

    match /invites/{email} {
      allow read, write, delete: if isAnyAdmin();
    }

    // ==========================================
    // STUDENTS & INDIVIDUAL LEARNERS
    // ==========================================
    match /individualStudents/{studentId} {
      allow read: if isStaffOrTutor() || (isAuth() && (resource.data.firebaseUid == request.auth.uid || resource.data.parentId == request.auth.uid || resource.data.parentId == request.auth.token.email));
      allow create: if isStaffOrTutor() || (isAuth() && isSchoolOwner(request.resource.data.schoolId));
      allow update: if isStaffOrTutor() || (isAuth() && (resource.data.firebaseUid == request.auth.uid || isSchoolOwner(resource.data.schoolId)));
      allow delete: if isAnyAdmin() || (isAuth() && isSchoolOwner(resource.data.schoolId));
    }

    match /students/{studentId} {
      allow read: if isStaffOrTutor() || (isAuth() && (resource.data.firebaseUid == request.auth.uid || resource.data.parentId == request.auth.uid || resource.data.parentId == request.auth.token.email));
      allow create: if isStaffOrTutor();
      allow update: if isStaffOrTutor() || (isAuth() && resource.data.firebaseUid == request.auth.uid);
      allow delete: if isAnyAdmin();
    }

    match /studentModules/{docId} {
      allow read: if isStaffOrTutor() || (isAuth() && (resource.data.studentUid == request.auth.uid || resource.data.studentId == request.auth.uid));
      allow create, update: if isStaffOrTutor();
      allow delete: if isAnyAdmin();
    }

    match /personalResources/{docId} {
      allow read: if isStaffOrTutor() || (isAuth() && (resource.data.userId == request.auth.uid || resource.data.studentId == request.auth.uid));
      allow create, update: if isStaffOrTutor();
      allow delete: if isAnyAdmin();
    }

    match /personalLinks/{docId} {
      allow read: if isStaffOrTutor() || (isAuth() && (resource.data.userId == request.auth.uid || resource.data.studentId == request.auth.uid));
      allow create, update: if isStaffOrTutor();
      allow delete: if isAnyAdmin();
    }

    // ==========================================
    // GENERAL & SCHOOL RESOURCES / EXAMS / LINKS
    // ==========================================
    match /resources/{resourceId} {
      allow read: if true;
      allow create, update, delete: if isStaffOrTutor();
    }

    match /links/{linkId} {
      allow read: if true;
      allow create, update, delete: if isStaffOrTutor();
    }

    match /exams/{examId} {
      allow read: if isAuth();
      allow create, update, delete: if isStaffOrTutor();
    }

    match /schoolResources/{docId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || (isAuth() && isSchoolOwner(resource.data.schoolId));
      allow create: if isAnyAdmin() || isStaffOrTutor() || (isAuth() && isSchoolOwner(request.resource.data.schoolId));
      allow update, delete: if isAnyAdmin() || isStaffOrTutor() || (isAuth() && isSchoolOwner(resource.data.schoolId));
    }

    match /schoolLinks/{docId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || (isAuth() && isSchoolOwner(resource.data.schoolId));
      allow create: if isAnyAdmin() || isStaffOrTutor() || (isAuth() && isSchoolOwner(request.resource.data.schoolId));
      allow update, delete: if isAnyAdmin() || isStaffOrTutor() || (isAuth() && isSchoolOwner(resource.data.schoolId));
    }

    match /schoolExams/{docId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || (isAuth() && isSchoolOwner(resource.data.schoolId));
      allow create: if isAnyAdmin() || isStaffOrTutor() || (isAuth() && isSchoolOwner(request.resource.data.schoolId));
      allow update, delete: if isAnyAdmin() || isStaffOrTutor() || (isAuth() && isSchoolOwner(resource.data.schoolId));
    }

    match /schoolPasscodes/{docId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || (isAuth() && isSchoolOwner(resource.data.schoolId));
      allow create: if isAnyAdmin() || isStaffOrTutor() || (isAuth() && isSchoolOwner(request.resource.data.schoolId));
      allow update, delete: if isAnyAdmin() || isStaffOrTutor() || (isAuth() && isSchoolOwner(resource.data.schoolId));
    }

    match /staffGeneralResources/{resId} {
      allow read: if isStaffOrTutor();
      allow create, update, delete: if isStaffOrTutor();
    }

    match /staffSchoolAccess/{docId} {
      allow read, write: if isStaffOrTutor();
    }

    match /staffRegistration/{docId} {
      allow read, write: if isAnyAdmin();
    }

    match /pendingStaff/{docId} {
      allow create: if true;
      allow read, update, delete: if isAnyAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
    }

    // ==========================================
    // PARENTS & PAYMENTS & ENROLLMENTS
    // ==========================================
    match /parents/{parentId} {
      allow read: if isAnyAdmin() || (isAuth() && request.auth.uid == parentId);
      allow create: if isAuth() && request.auth.uid == parentId;
      allow update: if isAnyAdmin() || (isAuth() && request.auth.uid == parentId);
      allow delete: if isSuperAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAnyAdmin() || (isAuth() && (resource.data.parentId == request.auth.uid || resource.data.userId == request.auth.uid));
      allow create: if isAuth() && (request.resource.data.parentId == request.auth.uid || request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAnyAdmin();
    }

    match /enrollment_requests/{reqId} {
      allow create: if isAuth() && request.resource.data.parentId == request.auth.uid;
      allow read, update, delete: if isAnyAdmin() || (isAuth() && resource.data.parentId == request.auth.uid);
    }

    match /student_requests/{requestId} {
      allow create: if isAuth() && request.resource.data.parentId == request.auth.uid;
      allow read, update, delete: if isAnyAdmin() || (isAuth() && resource.data.parentId == request.auth.uid);
    }

    match /tutor_applications/{appId} {
      allow create: if true;
      allow read, update, delete: if isAnyAdmin() || (isAuth() && resource.data.email == request.auth.token.email);
    }

    match /tutors/{tutorId} {
      allow read: if true;
      allow create, update: if isAnyAdmin() || (isAuth() && request.auth.uid == tutorId);
      allow delete: if isAnyAdmin();
    }

    // ==========================================
    // NOTIFICATIONS & MESSAGES & LOGS
    // ==========================================
    match /notifications/{notificationId} {
      allow read: if isAnyAdmin() || (isAuth() && (resource.data.recipientId == request.auth.uid || resource.data.recipientId == request.auth.token.email || resource.data.recipientId == 'all' || (resource.data.recipientId == 'all_students' && userRole() in ['STUDENT','student']) || (resource.data.recipientId == 'all_staff' && userRole() in ['STAFF','staff','TUTOR','tutor','INSTRUCTOR','instructor'])));
      allow create: if isAnyAdmin();
      allow update: if isAnyAdmin() || (isAuth() && resource.data.recipientId == request.auth.uid);
      allow delete: if isAnyAdmin();
    }

    match /activityLogs/{logId} {
      allow read: if isAnyAdmin();
      allow create: if isAuth() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if isAnyAdmin();
    }

    match /contact_messages/{msgId} {
      allow create: if true;
      allow read, update, delete: if isAnyAdmin();
    }

    // ==========================================
    // PUBLIC CONTENT & CMS
    // ==========================================
    match /page_sections/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /pages/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /sections/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /programs/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /services/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /portfolio/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /kidsProjects/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /blog/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /newsCorner/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /faqs/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /testimonials/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /schools/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /schoolPrograms/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAnyAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Authentication & Role Checks
    function isAuth() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuth() && (
        request.auth.token.email == 'johnrufai242@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('(?i)^johnrufai242@gmail\\.com$')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['SUPER_ADMIN', 'super_admin', 'admin', 'ADMIN'])
      );
    }

    function isAnyAdmin() {
      return isAuth() && (
        request.auth.token.email == 'johnrufai242@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('(?i)^johnrufai242@gmail\\.com$')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in [
           'SUPER_ADMIN', 'super_admin', 'ADMIN', 'admin', 
           'CONTENT_ADMIN', 'EDUCATION_ADMIN', 'SERVICES_ADMIN', 
           'MARKETING_ADMIN', 'SUPPORT_ADMIN'
         ])
      );
    }

    function isStaffOrTutor() {
      return isAuth() && (
        isAnyAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['STAFF', 'staff', 'TUTOR', 'tutor', 'instructor', 'INSTRUCTOR'])
      );
    }

    function isSchoolUser() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['SCHOOL', 'school'];
    }

    function userSchoolId() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId
        : null;
    }

    function isSameSchool(schoolId) {
      return isSchoolUser() && schoolId != null && schoolId == userSchoolId();
    }

    function isOwnStudent(data) {
      return isAuth() && (
        data.firebaseUid == request.auth.uid ||
        data.userId == request.auth.uid
      );
    }

    function isOwnParent(data) {
      return isAuth() && (
        data.parentId == request.auth.uid ||
        data.userId == request.auth.uid ||
        data.firebaseUid == request.auth.uid
      );
    }

    // ==========================================
    // USERS & PORTAL PROFILES
    // ==========================================
    match /users/{userId} {
      allow read: if isAnyAdmin() || (isAuth() && request.auth.uid == userId);
      allow create: if isAuth() && (request.auth.uid == userId || isAnyAdmin());
      allow update: if isAuth() && (
        isSuperAdmin() || 
        isAnyAdmin() ||
        request.auth.uid == userId
      );
      allow delete: if isSuperAdmin();
    }

    match /admins/{userId} {
      allow read: if isAnyAdmin() || (isAuth() && request.auth.uid == userId);
      allow write: if isSuperAdmin();
    }

    match /invites/{email} {
      allow read: if true;
      allow write: if isAnyAdmin();
      allow delete: if isAuth();
    }

    // ==========================================
    // STUDENTS & INDIVIDUAL LEARNERS
    // ==========================================
    match /individualStudents/{studentId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || isOwnStudent(resource.data) || isOwnParent(resource.data) || isSameSchool(resource.data.schoolId);
      allow write, delete: if isStaffOrTutor() || isAnyAdmin() || (isOwnStudent(resource.data) && request.resource.data.firebaseUid == request.auth.uid);
    }

    match /students/{studentId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || isOwnStudent(resource.data) || isOwnParent(resource.data) || isSameSchool(resource.data.schoolId);
      allow write, delete: if isStaffOrTutor() || isAnyAdmin();
    }

    match /studentModules/{docId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || isOwnStudent(resource.data) || isOwnParent(resource.data) || isSameSchool(resource.data.schoolId);
      allow write, delete: if isStaffOrTutor() || isAnyAdmin();
    }

    match /personalResources/{docId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || isOwnStudent(resource.data) || isOwnParent(resource.data);
      allow write, delete: if isStaffOrTutor() || isAnyAdmin();
    }

    match /personalLinks/{docId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || isOwnStudent(resource.data) || isOwnParent(resource.data);
      allow write, delete: if isStaffOrTutor() || isAnyAdmin();
    }

    // ==========================================
    // GENERAL & SCHOOL RESOURCES / EXAMS / LINKS
    // ==========================================
    match /resources/{resourceId} {
      allow read: if isAuth();
      allow write, delete: if isStaffOrTutor() || isAnyAdmin();
    }

    match /links/{linkId} {
      allow read: if true;
      allow write, delete: if isStaffOrTutor() || isAnyAdmin();
    }

    match /exams/{examId} {
      allow read: if true;
      allow write, delete: if isStaffOrTutor() || isAnyAdmin();
    }

    match /schoolResources/{resourceId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || isSameSchool(resource.data.schoolId) || isOwnStudent(resource.data) || isOwnParent(resource.data);
      allow create: if isStaffOrTutor() || isAnyAdmin() || (isSameSchool(request.resource.data.schoolId) && request.resource.data.schoolId == userSchoolId());
      allow update: if isStaffOrTutor() || isAnyAdmin() || (isSameSchool(resource.data.schoolId) && isSameSchool(request.resource.data.schoolId));
      allow delete: if isStaffOrTutor() || isAnyAdmin() || isSameSchool(resource.data.schoolId);
    }

    match /schoolLinks/{linkId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || isSameSchool(resource.data.schoolId) || isOwnStudent(resource.data) || isOwnParent(resource.data);
      allow create: if isStaffOrTutor() || isAnyAdmin() || (isSameSchool(request.resource.data.schoolId) && request.resource.data.schoolId == userSchoolId());
      allow update: if isStaffOrTutor() || isAnyAdmin() || (isSameSchool(resource.data.schoolId) && isSameSchool(request.resource.data.schoolId));
      allow delete: if isStaffOrTutor() || isAnyAdmin() || isSameSchool(resource.data.schoolId);
    }

    match /schoolExams/{examId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || isSameSchool(resource.data.schoolId) || isOwnStudent(resource.data) || isOwnParent(resource.data);
      allow create: if isStaffOrTutor() || isAnyAdmin() || (isSameSchool(request.resource.data.schoolId) && request.resource.data.schoolId == userSchoolId());
      allow update: if isStaffOrTutor() || isAnyAdmin() || (isSameSchool(resource.data.schoolId) && isSameSchool(request.resource.data.schoolId));
      allow delete: if isStaffOrTutor() || isAnyAdmin() || isSameSchool(resource.data.schoolId);
    }

    match /schoolPasscodes/{docId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || isSameSchool(resource.data.schoolId);
      allow write, delete: if isStaffOrTutor() || isAnyAdmin() || (isSameSchool(resource.data.schoolId) && request.resource.data.schoolId == userSchoolId());
    }

    match /staffGeneralResources/{resId} {
      allow read: if isStaffOrTutor();
      allow write, delete: if isStaffOrTutor() || isAnyAdmin();
    }

    match /staffSchoolAccess/{docId} {
      allow read: if isStaffOrTutor();
      allow write: if isStaffOrTutor() || isAnyAdmin();
    }

    match /staffRegistration/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAnyAdmin();
    }

    match /pendingStaff/{docId} {
      allow read: if isAnyAdmin() || (isAuth() && request.auth.uid == resource.data.userId);
      allow write, delete: if isAnyAdmin() || isStaffOrTutor();
    }

    // ==========================================
    // PARENTS & PAYMENTS & ENROLLMENTS
    // ==========================================
    match /parents/{parentId} {
      allow read: if isAnyAdmin() || isStaffOrTutor() || (isAuth() && request.auth.uid == parentId);
      allow create: if isAuth() && request.auth.uid == parentId;
      allow update: if isStaffOrTutor() || (isAuth() && request.auth.uid == parentId) || isAnyAdmin();
      allow delete: if isSuperAdmin() || isAnyAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAuth();
      allow create: if isAnyAdmin() || (isAuth() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending');
      allow update, delete: if isAnyAdmin();
    }

    match /enrollment_requests/{reqId} {
      allow create: if true;
      allow read: if isAnyAdmin() || (isAuth() && resource.data.parentId == request.auth.uid);
      allow update: if isAnyAdmin() || (isAuth() && resource.data.parentId == request.auth.uid && request.resource.data.parentId == request.auth.uid);
      allow delete: if isAnyAdmin() || (isAuth() && resource.data.parentId == request.auth.uid);
    }

    match /student_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAnyAdmin() || (isAuth() && resource.data.parentId == request.auth.uid);
    }

    match /tutor_applications/{appId} {
      allow create: if true;
      allow read, update, delete: if isAnyAdmin();
    }

    match /tutors/{tutorId} {
      allow read: if true;
      allow write: if isAnyAdmin() || isStaffOrTutor() || (isAuth() && request.auth.uid == tutorId);
    }

    // ==========================================
    // NOTIFICATIONS & MESSAGES & LOGS
    // ==========================================
    match /notifications/{notificationId} {
      allow read: if isAuth();
      allow create, update, delete: if isAnyAdmin();
    }

    match /activityLogs/{logId} {
      allow read: if isAnyAdmin();
      allow write: if isAnyAdmin();
    }

    match /contact_messages/{msgId} {
      allow create: if true;
      allow read, update, delete: if isAnyAdmin();
    }

    // ==========================================
    // PUBLIC CONTENT & CMS
    // ==========================================
    match /page_sections/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /pages/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /sections/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /programs/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /services/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /portfolio/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /kidsProjects/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /blog/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /newsCorner/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    match /faqs/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /testimonials/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /schools/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /schoolPrograms/{document=**} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAnyAdmin() || isAuth();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
